class Document:
    def __init__(self, content):
        self.content = content

class Printer:
    # Printer depends on Document only during the print_doc execution
    def print_doc(self, document):
        print(f"Printing document: {document.content}")

if __name__ == "__main__":
    doc = Document("UML Class Diagram Notes")
    printer = Printer()
    printer.print_doc(doc)
